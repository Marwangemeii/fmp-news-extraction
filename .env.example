# Copy to .env and fill in. .env is gitignored. `npm start` and `npm run eval` load it
# with Node's built-in --env-file-if-exists (no dotenv package).

# Claude API key for the labeller/extractor (required when a publisher uses label: 'llm').
ANTHROPIC_API_KEY=

# Optional overrides (defaults in src/llm/config.js):
# LLM_CLASSIFY_MODEL=claude-haiku-5-5
# LLM_EXTRACT_MODEL=claude-haiku-5-5   # e.g. claude-sonnet-5-5 to compare in `npm run eval`
# LLM_BUDGET_USD=1                      # stop LLM calls once this run's estimated spend reaches it
