{
  "name": "fmp-news-extraction",
  "version": "0.1.0",
  "private": true,
  "description": "Collects 14 days of articles from 10 financial news publishers, labels them, and writes articles.jsonl.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/run.js",
    "test": "node --test \"test/*.test.js\"",
    "validate": "node scripts/validate.js",
    "explain": "node scripts/explain.js",
    "eval": "node --env-file-if-exists=.env scripts/eval.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "playwright": "^1.65.1"
  }
}
